		"typecheck": "tsc --noEmit",
		"check:fix": "biome check --write --unsafe"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.8",
		"@types/bun": "latest"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@opentui/core": "^0.1.90",
		"zod": "^3.23.8"
	}
}
